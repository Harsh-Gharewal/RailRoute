# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
